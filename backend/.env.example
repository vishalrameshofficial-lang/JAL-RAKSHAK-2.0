# JAL-RAKSHAK Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Leave empty to use built-in resilient In-Memory engine)
MONGODB_URI=mongodb://localhost:27017/jal_rakshak

# Station Configuration
DEFAULT_DEVICE_ID=JR001
STATION_NAME="JAL-RAKSHAK NODE 01"
STATION_LOCATION="Indus Environmental Hydrology Basin, Station Alpha"
STATION_LAT=28.6139
STATION_LNG=77.2090

# Telemetry Configuration
OFFLINE_TIMEOUT_SECONDS=15
DEMO_SIMULATION_ENABLED=true
DEMO_INTERVAL_MS=3000
